{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug MCP (HTTP)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/McpDemo/bin/Debug/net10.0/McpDemo.dll",
      "cwd": "${workspaceFolder}/src/McpDemo",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}